flowchart TB
    subgraph Users["People"]
        analyst(["Security Analyst"])
        compliance(["Compliance / Audit"])
        platformEng(["Platform Engineer"])
        schemaAuthor(["Schema Author"])
    end

    subgraph SourceSystems["Source Systems"]
        AD[("Active Directory")]
        Workday[("Workday HR")]
        SQLFleet[("SQL Server Fleet")]
    end

    subgraph IngestionGroup["Ingestion"]
        Airbyte["Airbyte<br/>connector platform"]
        ScoutCustom["Scout residual<br/>bespoke connectors only"]
        Trailhead["Trailhead<br/>Airflow DAGs, config"]
    end

    subgraph TransformGroup["Transform"]
        Forge["Forge<br/>Spark engine"]
        dbtModels["dbt models<br/>conform + SCD2 snapshots, config"]
        ScoringLogic["Confidence scoring<br/>thin custom PySpark"]
    end

    subgraph LakehouseGroup["Lakehouse -- Bedrock"]
        Nessie["Nessie catalog"]
        NessiePG[("Nessie's Postgres")]
        S3Data[("S3")]
        Nessie <--> NessiePG
        Nessie --> S3Data
    end

    subgraph SchemaGroup["Schema Definition -- Blueprint"]
        DataGerry["DataGerry<br/>Type/Relation UI plus API"]
        DGMongo[("DataGerry MongoDB<br/>plus RabbitMQ")]
        Bridge["DataGerry Bridge<br/>thin custom sync"]
        DataGerry <--> DGMongo
    end

    subgraph ServingGroup["Serving"]
        Overlook["Overlook -- Trino"]
        Superset["Superset<br/>reports and dashboards"]
    end

    subgraph CoreGroup["Core Platform"]
        Atlas["Atlas<br/>core engine and API"]
        AtlasDB[("Postgres<br/>operational store")]
        OPA["OPA<br/>authz decisions"]
    end

    subgraph UIGroup["User-Facing UI"]
        Compass["Compass<br/>traversal UI"]
    end

    subgraph PlatformGroup["Platform / Ops"]
        Anchor["Anchor -- Terraform/Helm"]
        Conveyor["Conveyor -- GitHub Actions"]
        VaultBox["Vault / OpenBao"]
        PromStack["kube-prometheus-stack + Loki"]
    end

    AD --> Airbyte
    Workday --> Airbyte
    SQLFleet --> Airbyte
    Trailhead -->|triggers| Airbyte
    Trailhead -->|triggers| ScoutCustom
    Trailhead -->|orchestrates| Forge
    Airbyte -->|raw, Bronze| Forge
    ScoutCustom -->|raw, Bronze| Forge
    Forge --> dbtModels --> ScoringLogic
    ScoringLogic -->|writes Silver/Gold| Nessie
    Overlook -->|queries| Nessie
    Superset -->|SQL| Overlook
    Overlook --> Atlas

    schemaAuthor --> DataGerry
    DataGerry -->|Type/Relation API| Bridge
    Bridge -->|generates DDL| Nessie
    Bridge -->|refreshes cache| Atlas

    Atlas <--> AtlasDB
    Atlas <--> OPA
    analyst --> Compass
    compliance --> Superset
    platformEng -->|manages via API| Atlas
    Compass --> Atlas

    Anchor -.->|provisions| CoreGroup
    Conveyor -.->|deploys| Atlas
    Conveyor -.->|deploys| Compass
    Conveyor -.->|deploys| Bridge
    VaultBox -.->|secrets| Atlas
    VaultBox -.->|secrets| Airbyte
    PromStack -.->|observes| Atlas
    PromStack -.->|observes| Trailhead

    classDef offshelf fill:#4fe3a8,stroke:#333,color:#111
    classDef custom fill:#ff5d5d,stroke:#333,color:#fff
    classDef person fill:#63a6ff,stroke:#333,color:#fff

    class Airbyte,Trailhead,Forge,dbtModels,Nessie,NessiePG,S3Data,DataGerry,DGMongo,Overlook,Superset,OPA,Anchor,Conveyor,VaultBox,PromStack,AtlasDB offshelf
    class ScoutCustom,ScoringLogic,Bridge,Atlas,Compass custom
    class analyst,compliance,platformEng,schemaAuthor person
